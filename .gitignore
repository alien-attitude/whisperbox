# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Vite ──────────────────────────────────────────────────────
*.local
.vite/

# ── Environment files ─────────────────────────────────────────
# Never commit secrets or API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS artifacts ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing ───────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Package manager locks (keep only one) ─────────────────────
# Uncomment the ones you are NOT using:
# package-lock.json   # if using yarn or pnpm
# yarn.lock           # if using npm or pnpm
# pnpm-lock.yaml      # if using npm or yarn

# ── Misc ──────────────────────────────────────────────────────
*.tgz
*.zip
.cache/
tmp/
temp/
